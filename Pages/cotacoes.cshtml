@page "/cotacoes"
@model CotacoesEPC.Pages.cotacoesModel
@{
    Layout = null;
    ViewData["Title"] = "Cotações";
}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - CotacoesEPC</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />

<header class="dashboard-header">
    <div class="logo-area">
        <img src="~/images/sabesp.svg" alt="sabesp" class="logo" />
    </div>

    <button class="menu-toggle" aria-label="Menu">☰</button>

    <nav class="menu">
        <a class="menu-item" href="/dashboard">Dashboard</a>
        <a class="menu-item active" href="/cotacoes">Cotações</a>
        <a class="menu-item" href="/fornecedores">Fornecedores</a>
        <a class="menu-item" href="/planilhas">Planilhas</a>
    </nav>

    <div class="user-area">
        <button class="user" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-icon">R</div>
            <span class="user-name">Rafael</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuBtn">
            <li><h6 class="dropdown-header d-md-none">Rafael</h6></li>
            <li><hr class="dropdown-divider d-md-none"></li>
            <li><a class="dropdown-item" href="#" onclick="logout(event)">Sair</a></li>
        </ul>
    </div>
</header>

<main class="dashboard-container">
    <div class="servicos-header">
        <h2 class="title">Cotações</h2>
        <div class="header-buttons">
            <button class="btn-nova-cotacao btn-criar-individual" onclick="openCreateModal()">+ Nova Cotação</button>
            <button class="btn-nova-cotacao btn-secondary" onclick="openBulkImportModal()">Adicionar em Lote</button>
            <button class="btn-nova-intencao" onclick="openIntencaoModal()">+ Intenção de Cotação</button>
        </div>
    </div>

    <!-- BUSCA POR TEXTO - LINHA 1 -->
    <section class="servicos-filters" style="border-bottom: 1px solid #e0e0e0; padding-bottom: 12px; margin-bottom: 12px;">
        <div class="search-group">
            <input type="text" class="search-input" id="searchInput" placeholder="Pesquisar por item" />
            <button class="btn-filtrar" id="btnFiltrar">🔍 Buscar</button>
            <button class="btn-limpar" id="btnLimpar">Limpar Filtros</button>
        </div>
    </section>

    <!-- FILTROS ESTRUTURADOS - LINHA 2 -->
    <section class="servicos-filters" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;">
        <div class="filter-group" style="flex: 1; min-width: 140px; margin: 0;">
            <label class="filter-label" style="margin-bottom: 4px;">Setor:</label>
            <select class="filter-select" id="sectorFilterSelect" style="width: 100%;">
                <option value="">Todos</option>
            </select>
        </div>

        <div class="filter-group" style="flex: 1; min-width: 140px; margin: 0;">
            <label class="filter-label" style="margin-bottom: 4px;">Responsável:</label>
            <select class="filter-select" id="responsibleFilterSelect" style="width: 100%;">
                <option value="">Todos</option>
            </select>
        </div>

        <div class="filter-group" style="flex: 1; min-width: 160px; margin: 0;">
            <label class="filter-label" style="margin-bottom: 4px;">Fornecedor:</label>
            <select class="filter-select" id="supplierFilterSelect" style="width: 100%;">
                <option value="">Todos</option>
            </select>
        </div>

        <div style="flex: 2; min-width: 300px; display: flex; flex-direction: column; gap: 2px;">
            <div style="display: flex; align-items: center; gap: 0; background: #f4f8fb; border: 1.5px solid #b6cfe0; border-radius: 8px; padding: 6px 10px;">
                <div style="display: flex; flex-direction: column; gap: 3px; flex: 1;">
                    <span style="font-size: 10px; color: #6e8fa8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">I0 De:</span>
                    <div style="display: flex; gap: 4px;">
                        <select class="filter-select" id="i0StartMonth" style="flex: 1; min-width: 52px; font-size: 12px;">
                            <option value="">Mês</option>
                            <option value="1">Jan</option>
                            <option value="2">Fev</option>
                            <option value="3">Mar</option>
                            <option value="4">Abr</option>
                            <option value="5">Mai</option>
                            <option value="6">Jun</option>
                            <option value="7">Jul</option>
                            <option value="8">Ago</option>
                            <option value="9">Set</option>
                            <option value="10">Out</option>
                            <option value="11">Nov</option>
                            <option value="12">Dez</option>
                        </select>
                        <select class="filter-select" id="i0StartYear" style="flex: 1; min-width: 52px; font-size: 12px;">
                            <option value="">Ano</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                            <option value="2028">2028</option>
                        </select>
                    </div>
                </div>
                <div style="width: 1px; background: #b6cfe0; align-self: stretch; margin: 0 10px;"></div>
                <div style="display: flex; flex-direction: column; gap: 3px; flex: 1;">
                    <span style="font-size: 10px; color: #6e8fa8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Até</span>
                    <div style="display: flex; gap: 4px;">
                        <select class="filter-select" id="i0EndMonth" style="flex: 1; min-width: 52px; font-size: 12px;">
                            <option value="">Mês</option>
                            <option value="1">Jan</option>
                            <option value="2">Fev</option>
                            <option value="3">Mar</option>
                            <option value="4">Abr</option>
                            <option value="5">Mai</option>
                            <option value="6">Jun</option>
                            <option value="7">Jul</option>
                            <option value="8">Ago</option>
                            <option value="9">Set</option>
                            <option value="10">Out</option>
                            <option value="11">Nov</option>
                            <option value="12">Dez</option>
                        </select>
                        <select class="filter-select" id="i0EndYear" style="flex: 1; min-width: 52px; font-size: 12px;">
                            <option value="">Ano</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                            <option value="2028">2028</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="searchIndicator" style="display: none; padding: 12px 16px; background: #e8f4f8; border-left: 4px solid #19d6ff; margin-bottom: 16px; border-radius: 4px;">
        <span style="color: #333; font-weight: 500;">Buscando por: <strong id="searchText"></strong></span>
    </div>

    <section class="servicos-table">
        <div id="emptyMessage" style="display: none; text-align: center; color: #999; padding: 60px 20px; font-size: 18px;">
            Nenhum insumo cadastrado. Crie um novo!
        </div>
        <table id="quotationsTableElement">
            <thead>
                <tr>
                    <th>I0 original</th>
                    <th>Setor</th>
                    <th>Item</th>
                    <th>Preço de Forn. Adotado</th>
                    <th>Responsável</th>
                    <th>Status</th>
                    <th title="Quantidade de vezes que os dados foram copiados">📋</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </section>
</main>

<!-- MODAL CRIAR/VISUALIZAR NOVO INSUMO -->
<div id="createModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Nova Cotação</h2>
            <button class="modal-close" onclick="closeCreateModal()">&times;</button>
        </div>
        <form class="modal-form">
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Setor*</label>
                    <select name="sectorId" required>
                        <option value="">Selecione um setor</option>
                    </select>
                </div>
            </div>
            
            <div class="paste-button-container">
                <button type="button" class="btn-paste" onclick="pasteFromClipboard()">📋 Colar dados da planilha</button>
            </div>
            
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Item* <small style="color:#888;font-weight:400;">(máx. 100 caracteres)</small></label>
                    <input type="text" placeholder="DESCRIÇÃO DO ITEM" maxlength="100" required />
                </div>
            </div>
            
            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>I0 Original da Cotação*</label>
                    <input type="text" placeholder="Ex: JAN/00" required />
                </div>
                <div class="form-group">
                    <label>Unidade*</label>
                    <input type="text" placeholder="Ex: Un., m², Kg" required />
                </div>
                <div class="form-group">
                    <label>Adotada - Preço de Forn. (corrigido)*</label>
                    <input type="number" placeholder="0,00" step="0.01" required />
                </div>
                <div class="form-group">
                    <label>Preço de montagem / instalação</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
            </div>

            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>Preço de Forn. Adotado*</label>
                    <input type="number" placeholder="0,00" step="0.01" required />
                </div>
                <div class="form-group">
                    <label>Média adotada</label>
                    <input type="text" placeholder="Digite aqui" />
                </div>
                <div class="form-group">
                    <label>Média Saneada</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Menor Valor</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
            </div>

            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>Média Aritmética</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Mediana</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
            </div>

            <h3 class="section-title">Preços das Empresas</h3>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 1*</label>
                        <div class="searchable-supplier-select" data-company-index="1">
                            <input 
                                type="text" 
                                class="supplier-search-input" 
                                placeholder="🔍 Selecione ou procure..." 
                                autocomplete="off"
                                required
                            />
                            <div class="supplier-dropdown" style="display: none;"></div>
                        </div>
                        <input 
                            type="hidden" 
                            name="nomeEmpresa1" 
                            class="hidden-supplier-name"
                            value=""
                            required
                        />
                        <input 
                            type="hidden" 
                            name="supplier1Id" 
                            class="hidden-supplier-id"
                            value=""
                        />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 1</label>
                        <input type="number" name="empresa1" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 2</label>
                        <div class="searchable-supplier-select" data-company-index="2">
                            <input 
                                type="text" 
                                class="supplier-search-input" 
                                placeholder="🔍 Selecione ou procure..." 
                                autocomplete="off"
                            />
                            <div class="supplier-dropdown" style="display: none;"></div>
                        </div>
                        <input 
                            type="hidden" 
                            name="nomeEmpresa2" 
                            class="hidden-supplier-name"
                            value=""
                        />
                        <input 
                            type="hidden" 
                            name="supplier2Id" 
                            class="hidden-supplier-id"
                            value=""
                        />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 2</label>
                        <input type="number" name="empresa2" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 3</label>
                        <div class="searchable-supplier-select" data-company-index="3">
                            <input 
                                type="text" 
                                class="supplier-search-input" 
                                placeholder="🔍 Selecione ou procure..." 
                                autocomplete="off"
                            />
                            <div class="supplier-dropdown" style="display: none;"></div>
                        </div>
                        <input 
                            type="hidden" 
                            name="nomeEmpresa3" 
                            class="hidden-supplier-name"
                            value=""
                        />
                        <input 
                            type="hidden" 
                            name="supplier3Id" 
                            class="hidden-supplier-id"
                            value=""
                        />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 3</label>
                        <input type="number" name="empresa3" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 4</label>
                        <div class="searchable-supplier-select" data-company-index="4">
                            <input 
                                type="text" 
                                class="supplier-search-input" 
                                placeholder="Buscar fornecedor ou digitar nome..." 
                                autocomplete="off"
                            />
                            <div class="supplier-dropdown" style="display: none;"></div>
                        </div>
                        <input 
                            type="hidden" 
                            name="nomeEmpresa4" 
                            class="hidden-supplier-name"
                            value=""
                        />
                        <input 
                            type="hidden" 
                            name="supplier4Id" 
                            class="hidden-supplier-id"
                            value=""
                        />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 4</label>
                        <input type="number" name="empresa4" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 5</label>
                        <div class="searchable-supplier-select" data-company-index="5">
                            <input 
                                type="text" 
                                class="supplier-search-input" 
                                placeholder="Buscar fornecedor ou digitar nome..." 
                                autocomplete="off"
                            />
                            <div class="supplier-dropdown" style="display: none;"></div>
                        </div>
                        <input 
                            type="hidden" 
                            name="nomeEmpresa5" 
                            class="hidden-supplier-name"
                            value=""
                        />
                        <input 
                            type="hidden" 
                            name="supplier5Id" 
                            class="hidden-supplier-id"
                            value=""
                        />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 5</label>
                        <input type="number" name="empresa5" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 6</label>
                        <div class="searchable-supplier-select" data-company-index="6">
                            <input 
                                type="text" 
                                class="supplier-search-input" 
                                placeholder="Buscar fornecedor ou digitar nome..." 
                                autocomplete="off"
                            />
                            <div class="supplier-dropdown" style="display: none;"></div>
                        </div>
                        <input 
                            type="hidden" 
                            name="nomeEmpresa6" 
                            class="hidden-supplier-name"
                            value=""
                        />
                        <input 
                            type="hidden" 
                            name="supplier6Id" 
                            class="hidden-supplier-id"
                            value=""
                        />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 6</label>
                        <input type="number" name="empresa6" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label>Justificativa do preço adotado</label>
                    <textarea placeholder="DIGITE A JUSTIFICATIVA..." rows="4"></textarea>
                </div>
            </div>

            <h3 class="section-title">Anexos (PDFs)</h3>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Adicionar Anexos PDF</label>
                    <input type="file" id="createAttachmentInput" accept=".pdf" multiple style="margin-bottom: 10px;" />
                    <p style="font-size: 12px; color: #666; margin: 5px 0;">Máximo 10MB por arquivo. Você será solicitado a descrever cada arquivo.</p>
                    <div id="createAttachmentsList"></div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeCreateModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Salvar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL EDITAR INSUMO -->
<div id="editModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Editar Cotação</h2>
            <button class="modal-close" onclick="closeEditModal()">&times;</button>
        </div>
        <form class="modal-form">
            <div class="form-row form-row-2col">
                <div class="form-group">
                    <label>Setor*</label>
                    <select name="sectorId" required>
                        <option value="">Selecione um setor</option>
                    </select>
                </div>
                <div class="form-group" id="editStatusGroup">
                    <label>Status</label>
                    <div id="editStatusDisplay" style="margin-bottom:8px;"></div>
