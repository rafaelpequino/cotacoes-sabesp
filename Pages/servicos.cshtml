<!-- MODAL: DESCRIÇÃO DO ANEXO -->
<div id="bulkAttachmentDescriptionModal" class="modal">
    <div class="modal-content" style="max-width: 500px; width: 90%;">
        <div class="modal-header">
            <h2>Descrição do Anexo</h2>
            <button class="modal-close" onclick="closeBulkAttachmentDescriptionModal()">&times;</button>
        </div>
        <div class="modal-form">
            <p style="margin-bottom: 16px; color: #555;">Digite uma descrição para o(s) arquivo(s) selecionado(s):</p>
            <div class="form-group">
                <label>Descrição*</label>
                <input type="text" id="bulkAttachmentDescription" placeholder="Ex: Orçamento da empresa X" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px;" />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeBulkAttachmentDescriptionModal()">Cancelar</button>
                <button type="button" class="btn-submit" onclick="confirmBulkAttachmentDescription()">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<script>
    // MODAL CRIAR
    function openCreateModal() {
        document.getElementById('createModal').style.display = 'flex';
    }

    function closeCreateModal() {
        document.getElementById('createModal').style.display = 'none';
    }

    // MODAL INTENÇÃO DE COTAÇÃO
    function openIntencaoModal() {
        document.getElementById('intencaoModal').style.display = 'flex';
    }

    function closeIntencaoModal() {
        document.getElementById('intencaoModal').style.display = 'none';
    }

    // MODAL EDITAR
    const editModal = document.getElementById('editModal');

    function openEditModal() {
        editModal.style.display = 'flex';
    }

    function closeEditModal() {
        editModal.style.display = 'none';
    }

    // MODAL VISUALIZAR
    const viewModal = document.getElementById('viewModal');

    function openViewModal() {
        viewModal.style.display = 'flex';
    }

    function closeViewModal() {
        viewModal.style.display = 'none';
    }

    function editFromView() {
        closeViewModal();
        openEditModal();
    }

    // Função para copiar dados
    // Função para mostrar notificação de cópia
    function showCopyNotification() {
        const notification = document.createElement('div');
        notification.className = 'copy-notification';
        notification.textContent = '✓ Dados copiados para a área de transferência';
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('show');
        }, 10);

        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
                document.body.removeChild(notification);
            }, 300);
        }, 2000);
    }

    // Função para colar dados da planilha
    function pasteFromClipboard() {
        navigator.clipboard.readText().then((text) => {
            try {
                const parsedData = parseClipboardData(text);
                fillFormWithParsedData(document.getElementById('createModal'), parsedData);
                showPasteNotification();
            } catch (error) {
                alert('Erro ao processar dados da planilha: ' + error.message);
                console.error('Erro completo:', error);
            }
        }).catch(() => {
            alert('Não foi possível acessar a área de transferência. Verifique as permissões do navegador.');
        });
    }

    function pasteFromClipboardEdit() {
        navigator.clipboard.readText().then((text) => {
            try {
                const parsedData = parseClipboardData(text);
                fillFormWithParsedData(document.getElementById('editModal'), parsedData);
                showPasteNotification();
            } catch (error) {
                alert('Erro ao processar dados da planilha: ' + error.message);
                console.error('Erro completo:', error);
            }
        }).catch(() => {
            alert('Não foi possível acessar a área de transferência. Verifique as permissões do navegador.');
        });
    }

    // Função para mostrar notificação de cola
    function showPasteNotification() {
        const notification = document.createElement('div');
        notification.className = 'paste-notification';
        notification.textContent = '✓ Dados colados com sucesso';
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('show');
        }, 10);

        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
                document.body.removeChild(notification);
            }, 300);
        }, 2000);
    }

    // Adicionar funcionalidade de cópia aos botões
    document.querySelectorAll('.btn-copiar').forEach((btn, index) => {
        btn.addEventListener('click', function() {
            copyServiceData('fev/2026');
        });
    });

    // Fechar modal ao clicar fora
    window.addEventListener('click', function(event) {
        const createModal = document.getElementById('createModal');
        const editModal = document.getElementById('editModal');
        const viewModal = document.getElementById('viewModal');
        const intencaoModal = document.getElementById('intencaoModal');
        const bulkImportModal = document.getElementById('bulkImportModal');
        const bulkCompaniesModal = document.getElementById('bulkCompaniesModal');
        const bulkPricesModal = document.getElementById('bulkPricesModal');
        const bulkViewAttachmentsModal = document.getElementById('bulkViewAttachmentsModal');
        const bulkAttachmentDescriptionModal = document.getElementById('bulkAttachmentDescriptionModal');

        if (event.target === createModal) {
            closeCreateModal();
        }
        if (event.target === editModal) {
            closeEditModal();
        }
        if (event.target === viewModal) {
            closeViewModal();
        }
        if (event.target === intencaoModal) {
            closeIntencaoModal();
        }
        if (event.target === bulkImportModal) {
            closeBulkImportModal();
        }
        if (event.target === bulkCompaniesModal) {
            closeBulkCompaniesModal();
        }
        if (event.target === bulkPricesModal) {
            closeBulkPricesModal();
        }
        if (event.target === bulkViewAttachmentsModal) {
            closeBulkViewAttachmentsModal();
        }
        if (event.target === bulkAttachmentDescriptionModal) {
            closeBulkAttachmentDescriptionModal();
        }
    });

    // Fechar modais com a tecla ESC - COM LÓGICA INTELIGENTE
    let escPressCount = 0;
    let escTimeout = null;

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            const bulkAttachmentDescriptionModal = document.getElementById('bulkAttachmentDescriptionModal');
            const bulkCompaniesModal = document.getElementById('bulkCompaniesModal');
            const bulkPricesModal = document.getElementById('bulkPricesModal');
            const bulkViewAttachmentsModal = document.getElementById('bulkViewAttachmentsModal');
            const bulkImportModal = document.getElementById('bulkImportModal');
            const createModal = document.getElementById('createModal');
            const editModal = document.getElementById('editModal');
            const viewModal = document.getElementById('viewModal');

            // Modal de descrição tem prioridade máxima
            if (bulkAttachmentDescriptionModal.style.display === 'block') {
                closeBulkAttachmentDescriptionModal();
                return;
            }

            // Se algum modal secundário estiver aberto, fechar apenas ele
            if (bulkCompaniesModal.style.display === 'block') {
                closeBulkCompaniesModal();
                return;
            }
            if (bulkPricesModal.style.display === 'block') {
                closeBulkPricesModal();
                return;
            }
            if (bulkViewAttachmentsModal.style.display === 'block') {
                closeBulkViewAttachmentsModal();
                return;
            }

            // Se modal principal de bulk import estiver aberto, precisa apertar ESC duas vezes
            if (bulkImportModal.style.display === 'block') {
                escPressCount++;
                clearTimeout(escTimeout);

                if (escPressCount === 1) {
                    // Primeira vez: avisar
                    console.log('⚠️ Pressione ESC novamente para fechar');
                    escTimeout = setTimeout(() => {
                        escPressCount = 0;
                    }, 1000);
                } else if (escPressCount >= 2) {
                    // Segunda vez: fechar
                    closeBulkImportModal();
                    escPressCount = 0;
                }
                return;
            }

            // Outros modais normais
            if (createModal.style.display === 'flex') {
                closeCreateModal();
            }
            if (editModal.style.display === 'flex') {
                closeEditModal();
            }
            if (viewModal.style.display === 'flex') {
                closeViewModal();
            }
        }
    });
</script>

