<!-- MODAL SECUNDÁRIO: VER/ADICIONAR ANEXOS -->
<div id="bulkViewAttachmentsModal" class="modal">
    <div class="modal-content bulk-view-attachments-modal-content">
        <div class="modal-header">
            <h2>Anexos</h2>
            <button class="modal-close" onclick="closeBulkViewAttachmentsModal()">&times;</button>
        </div>
        <div class="modal-form">
            <div id="bulkViewAttachmentsList">
                <!-- Será preenchido dinamicamente -->
            </div>
            
            <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600;">Adicionar novo anexo:</label>
                <input type="file" id="bulkAttachmentFileInput" accept=".pdf" multiple onchange="handleBulkFileUpload(event)" />
            </div>
