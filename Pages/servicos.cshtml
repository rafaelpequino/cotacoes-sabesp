@page
@model CotacoesEPC.Pages.servicosModel
@{
    Layout = null;
    ViewData["Title"] = "Serviços";
}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - CotacoesEPC</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />

<header class="dashboard-header">
    <div class="logo-area">
        <img src="~/images/sabesp.svg" alt="sabesp" class="logo" />
    </div>

    <button class="menu-toggle" aria-label="Menu">☰</button>

    <nav class="menu">
        <a class="menu-item" href="/dashboard">Dashboard</a>
        <a class="menu-item active" href="/servicos">Serviços</a>
        <a class="menu-item" href="/insumos">Insumos</a>
        <a class="menu-item" href="/planilhas">Planilhas</a>
    </nav>

    <div class="user-area">
        <button class="user" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-icon">R</div>
            <span class="user-name">Rafael</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuBtn">
            <li><h6 class="dropdown-header d-md-none">Rafael</h6></li>
            <li><hr class="dropdown-divider d-md-none"></li>
            <li><a class="dropdown-item" href="#" onclick="logout(event)">Sair</a></li>
        </ul>
    </div>
</header>

<main class="dashboard-container">
    <div class="servicos-header">
        <h2 class="title">Serviços</h2>
        <div class="header-buttons">
            <button class="btn-nova-cotacao btn-criar-individual" onclick="openCreateModal()">+ Nova Cotação</button>
            <button class="btn-nova-cotacao btn-secondary" onclick="openBulkImportModal()">Adicionar em Lote</button>
            <button class="btn-nova-intencao" onclick="openIntencaoModal()">+ Intenção de Cotação</button>
        </div>
    </div>

    <section class="servicos-filters">
        <div class="search-group">
            <input type="text" class="search-input" id="searchInput" placeholder="Pesquisar por item" />
            <button class="btn-filtrar" id="btnFiltrar">🔍 Buscar</button>
            <button class="btn-limpar" id="btnLimpar">Limpar Busca</button>
        </div>
        
        <div class="filter-group">
            <label class="filter-label">Ordenar por:</label>
            <select class="filter-select" id="sortSelect">
                <option value="">Relevância</option>
                <option value="recentes">Mais Recentes</option>
                <option value="preço_menor">Preço: Menor</option>
                <option value="preço_maior">Preço: Maior</option>
            </select>
        </div>

        <div class="filter-group">
            <label class="filter-label">Filtrar por Setor:</label>
            <select class="filter-select" id="sectorFilterSelect">
                <option value="">Todos os Setores</option>
            </select>
        </div>

        <div class="filter-group">
            <label class="filter-label">Filtrar por Responsável:</label>
            <select class="filter-select" id="responsibleFilterSelect">
                <option value="">Todos os Responsáveis</option>
            </select>
        </div>
    </section>

    <div id="searchIndicator" style="display: none; padding: 12px 16px; background: #e8f4f8; border-left: 4px solid #19d6ff; margin-bottom: 16px; border-radius: 4px;">
        <span style="color: #333; font-weight: 500;">Buscando por: <strong id="searchText"></strong></span>
    </div>

    <section class="servicos-table">
        <div id="emptyMessage" style="display: none; text-align: center; color: #999; padding: 60px 20px; font-size: 18px;">
            Nenhum serviço cadastrado. Crie um novo!
        </div>
        <table id="servicosTableElement">
            <thead>
                <tr>
                    <th>I0 original</th>
                    <th>Setor</th>
                    <th>Item</th>
                    <th>Unidade</th>
                    <th>Preço instalação</th>
                    <th>Preço de Forn. Adotado</th>
                    <th>Responsável</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </section>
</main>

<!-- MODAL CRIAR/VISUALIZAR NOVO SERVIÇO -->
<div id="createModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Nova Cotação</h2>
            <button class="modal-close" onclick="closeCreateModal()">&times;</button>
        </div>
        <form class="modal-form">
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Setor*</label>
                    <select name="sectorId" required>
                        <option value="">Selecione um setor</option>
                    </select>
                </div>
            </div>
            
            <div class="paste-button-container">
                <button type="button" class="btn-paste" onclick="pasteFromClipboard()">📋 Colar dados da planilha</button>
            </div>
            
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Item* <small style="color:#888;font-weight:400;">(máx. 50 caracteres)</small></label>
                    <input type="text" placeholder="DESCRIÇÃO DO ITEM" maxlength="50" required />
                </div>
            </div>
            
            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>I0 Original da Cotação*</label>
                    <input type="text" placeholder="Ex: JAN/00" required />
                </div>
                <div class="form-group">
                    <label>Unidade*</label>
                    <input type="text" placeholder="Ex: Un., m², Kg" required />
                </div>
                <div class="form-group">
                    <label>Adotada - Preço de Forn. (corrigido)*</label>
                    <input type="number" placeholder="0,00" step="0.01" required />
                </div>
                <div class="form-group">
                    <label>Preço de montagem / instalação*</label>
                    <input type="number" placeholder="0,00" step="0.01" required />
                </div>
            </div>

            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>Preço de Forn. Adotado*</label>
                    <input type="number" placeholder="0,00" step="0.01" required />
                </div>
                <div class="form-group">
                    <label>Média adotada</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Média Saneada</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Menor Valor</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
            </div>

            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>Média Aritmética</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Mediana</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
            </div>

            <h3 class="section-title">Preços das Empresas</h3>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 1</label>
                        <input type="text" name="nomeEmpresa1" placeholder="Ex: SABESP" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 1</label>
                        <input type="number" name="empresa1" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 2</label>
                        <input type="text" name="nomeEmpresa2" placeholder="Ex: VIZCA" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 2</label>
                        <input type="number" name="empresa2" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 3</label>
                        <input type="text" name="nomeEmpresa3" placeholder="Ex: FIA" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 3</label>
                        <input type="number" name="empresa3" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 4</label>
                        <input type="text" name="nomeEmpresa4" placeholder="Ex: COSTA" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 4</label>
                        <input type="number" name="empresa4" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 5</label>
                        <input type="text" name="nomeEmpresa5" placeholder="Ex: PONTE" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 5</label>
                        <input type="number" name="empresa5" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 6</label>
                        <input type="text" name="nomeEmpresa6" placeholder="Ex: Exemplo" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 6</label>
                        <input type="number" name="empresa6" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label>Justificativa do preço adotado</label>
                    <textarea placeholder="DIGITE A JUSTIFICATIVA..." rows="4"></textarea>
                </div>
            </div>

            <h3 class="section-title">Anexos (PDFs)</h3>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Adicionar Anexos PDF</label>
                    <input type="file" id="createAttachmentInput" accept=".pdf" multiple style="margin-bottom: 10px;" />
                    <p style="font-size: 12px; color: #666; margin: 5px 0;">Máximo 10MB por arquivo. Você será solicitado a descrever cada arquivo.</p>
                    <div id="createAttachmentsList"></div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeCreateModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Salvar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL EDITAR SERVIÇO -->
<div id="editModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Editar Cotação</h2>
            <button class="modal-close" onclick="closeEditModal()">&times;</button>
        </div>
        <form class="modal-form">
            <div class="form-row form-row-2col">
                <div class="form-group">
                    <label>Setor*</label>
                    <select name="sectorId" required>
                        <option value="">Selecione um setor</option>
                    </select>
                </div>
                <div class="form-group" id="editStatusGroup">
                    <label>Status</label>
                    <div id="editStatusDisplay" style="margin-bottom:8px;"></div>
                    <div class="cancelar-check-row">
                        <input type="checkbox" id="editCancelarCheck">
                        <label for="editCancelarCheck" class="cancelar-check-label">Cancelar esta cotação</label>
                    </div>
                    <small class="status-auto-note">Pendente/Concluída são definidos automaticamente</small>
                </div>
            </div>

            <div class="paste-button-container">
                <button type="button" class="btn-paste" onclick="pasteFromClipboardEdit()">📋 Colar dados da planilha</button>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label>Item* <small style="color:#888;font-weight:400;">(máx. 50 caracteres)</small></label>
                    <input type="text" placeholder="DESCRIÇÃO DO ITEM" maxlength="50" value="Assentamento de tubo não sei o que la la la..." required />
                </div>
            </div>
            
            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>I0 Original da Cotação*</label>
                    <input type="text" placeholder="Ex: JAN/00" value="JAN/00" required />
                </div>
                <div class="form-group">
                    <label>Unidade*</label>
                    <input type="text" placeholder="Ex: Un., m², Kg" value="Un." required />
                </div>
                <div class="form-group">
                    <label>Adotada - Preço de Forn. (corrigido)*</label>
                    <input type="number" placeholder="0,00" step="0.01" value="50000" required />
                </div>
                <div class="form-group">
                    <label>Preço de montagem / instalação*</label>
                    <input type="number" placeholder="0,00" step="0.01" value="5000" required />
                </div>
            </div>

            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>Preço de Forn. Adotado*</label>
                    <input type="number" placeholder="0,00" step="0.01" value="55000" required />
                </div>
                <div class="form-group">
                    <label>Média adotada</label>
                    <input type="number" placeholder="0,00" step="0.01" value="55000" />
                </div>
                <div class="form-group">
                    <label>Média Saneada</label>
                    <input type="number" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Menor Valor</label>
                    <input type="number" placeholder="0,00" step="0.01" value="50000" />
                </div>
            </div>

            <div class="form-row form-row-4col">
                <div class="form-group">
                    <label>Média Aritmética</label>
                    <input type="number" placeholder="0,00" step="0.01" value="52500" />
                </div>
                <div class="form-group">
                    <label>Mediana</label>
                    <input type="number" placeholder="0,00" step="0.01" value="55000" />
                </div>
            </div>

            <h3 class="section-title">Preços das Empresas</h3>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 1</label>
                        <input type="text" name="nomeEmpresa1" placeholder="Ex: SABESP" value="SABESP" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 1</label>
                        <input type="number" name="empresa1" placeholder="0,00" step="0.01" value="50000" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 2</label>
                        <input type="text" name="nomeEmpresa2" placeholder="Ex: VIZCA" value="VIZCA" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 2</label>
                        <input type="number" name="empresa2" placeholder="0,00" step="0.01" value="55000" />
                    </div>
                </div>
            </div>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 3</label>
                        <input type="text" name="nomeEmpresa3" placeholder="Ex: FIA" value="FIA" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 3</label>
                        <input type="number" name="empresa3" placeholder="0,00" step="0.01" value="52000" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 4</label>
                        <input type="text" name="nomeEmpresa4" placeholder="Ex: COSTA" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 4</label>
                        <input type="number" name="empresa4" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="form-row form-row-4col">
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 5</label>
                        <input type="text" name="nomeEmpresa5" placeholder="Ex: PONTE" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 5</label>
                        <input type="number" name="empresa5" placeholder="0,00" step="0.01" />
                    </div>
                </div>
                <div class="form-group-pair">
                    <div class="form-group">
                        <label>Nome da Empresa 6</label>
                        <input type="text" name="nomeEmpresa6" placeholder="Ex: Exemplo" />
                    </div>
                    <div class="form-group">
                        <label>Valor Empresa 6</label>
                        <input type="number" name="empresa6" placeholder="0,00" step="0.01" />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label>Justificativa do preço adotado</label>
                    <textarea placeholder="DIGITE A JUSTIFICATIVA..." rows="4">Preço de Forn. Adotado conforme análise de mercado</textarea>
                </div>
            </div>

            <h3 class="section-title">Anexos (PDFs)</h3>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Adicionar Novos Anexos PDF</label>
                    <input type="file" id="editAttachmentInput" accept=".pdf" multiple style="margin-bottom: 10px;" />
                    <p style="font-size: 12px; color: #666; margin: 5px 0;">Máximo 10MB por arquivo. Você será solicitado a descrever cada arquivo.</p>
                    <div id="editAttachmentsList"></div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Atualizar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL VISUALIZAR SERVIÇO -->
<div id="viewModal" class="modal">
    <div class="modal-content modal-view">
        <div class="modal-header">
            <h2>Detalhes da Cotação</h2>
            <button class="modal-close" onclick="closeViewModal()">&times;</button>
        </div>
        <div class="modal-view-content">
            <!-- SEÇÃO 1: Responsável e Setor -->
            <div class="view-section section-header">
                <div class="view-row-header">
                    <div class="view-item-header">
                        <span class="view-label">👤 Responsável</span>
                        <span class="view-value-header">Rafael Pequino Freire</span>
                    </div>
                    <div class="view-item-header">
                        <span class="view-label">🏢 Setor</span>
                        <span class="view-value-header">Elétrica</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 2: Informações Principais -->
            <div class="view-section">
                <h3>📋 Informações da Cotação</h3>
                <div class="info-grid">
                    <div class="info-card">
                        <span class="info-label">I0 Original</span>
                        <span class="info-value">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Item</span>
                        <span class="info-value">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Unidade</span>
                        <span class="info-value">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Adotada</span>
                        <span class="info-value price">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Preço Montagem</span>
                        <span class="info-value price">-</span>
                    </div>
                    <div class="info-card highlight">
                        <span class="info-label">Preço Adotado</span>
                        <span class="info-value price-main">-</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 3: Médias e Medianas -->
            <div class="view-section">
                <h3>📊 Médias e Estatísticas</h3>
                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-label">Média Adotada</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Média Saneada</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Menor Valor</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Média Aritmética</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Mediana</span>
                        <span class="stat-value">-</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 4: Preços das Empresas -->
            <div class="view-section">
                <h3>🏪 Cotações das Empresas</h3>
                <div class="companies-grid">
                    <div class="company-card" id="company-card-1">
                        <span class="company-label" id="company-name-1">Empresa 1</span>
                        <span class="company-value" id="company-value-1">-</span>
                    </div>
                    <div class="company-card" id="company-card-2">
                        <span class="company-label" id="company-name-2">Empresa 2</span>
                        <span class="company-value" id="company-value-2">-</span>
                    </div>
                    <div class="company-card" id="company-card-3">
                        <span class="company-label" id="company-name-3">Empresa 3</span>
                        <span class="company-value" id="company-value-3">-</span>
                    </div>
                    <div class="company-card" id="company-card-4">
                        <span class="company-label" id="company-name-4">Empresa 4</span>
                        <span class="company-value" id="company-value-4">-</span>
                    </div>
                    <div class="company-card" id="company-card-5">
                        <span class="company-label" id="company-name-5">Empresa 5</span>
                        <span class="company-value" id="company-value-5">-</span>
                    </div>
                    <div class="company-card" id="company-card-6">
                        <span class="company-label" id="company-name-6">Empresa 6</span>
                        <span class="company-value" id="company-value-6">-</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 5: Justificativa -->
            <div class="view-section">
                <h3>📝 Justificativa</h3>
                <div class="justification-box">
                    <p class="justification-text">-</p>
                </div>
            </div>

            <!-- SEÇÃO 6: Anexos -->
            <div class="view-section">
                <h3>📎 Anexos (PDFs)</h3>
                <div id="viewAttachmentsList">
                    <p class="view-text" style="color: #999;">Nenhum anexo disponível</p>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeViewModal()">Fechar</button>
                <button type="button" class="btn-submit" onclick="editFromView()">Editar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL INTENÇÃO DE COTAÇÃO -->
<div id="intencaoModal" class="modal">
    <div class="modal-content" style="max-width: 500px; width: 95%;">
        <div class="modal-header">
            <h2>🟡 Intenção de Cotação</h2>
            <button class="modal-close" onclick="closeIntencaoModal()">&times;</button>
        </div>
        <form class="modal-form" id="intencaoForm">
            <p style="color:#666; margin-bottom:16px; font-size:14px;">
                Registre uma cotação ainda pendente. Apenas <strong>Setor</strong> e <strong>Descrição</strong> são obrigatórios.
                O status ficará como <span style="color:#f57f17;font-weight:600;">Pendente</span>.
            </p>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Setor*</label>
                    <select name="sectorId" id="intencaoSectorSelect" required>
                        <option value="">Selecione um setor</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Descrição do Item* <small style="color:#888;font-weight:400;">(máx. 50 caracteres)</small></label>
                    <input type="text" id="intencaoItem" placeholder="DESCRIÇÃO DO ITEM" maxlength="50" required />
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeIntencaoModal()">Cancelar</button>
                <button type="submit" class="btn-submit" style="background:#f57f17;">Registrar Intenção</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================
     MODAIS DE IMPORTAÇÃO EM MASSA
     ======================================== -->

<!-- MODAL PRINCIPAL: IMPORTAÇÃO EM MASSA -->
<div id="bulkImportModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Importação em Massa de Cotações</h2>
            <button class="modal-close" onclick="closeBulkImportModal()">&times;</button>
        </div>
        <div class="modal-form">
            <!-- Área de colagem -->
            <div id="bulkPasteArea" class="bulk-paste-area">
                <button onclick="bulkPasteFromClipboard()" class="btn btn-primary">
                    📋 Colar do Excel
                </button>
            </div>

            <!-- Área de pré-visualização -->
            <div id="bulkPreviewArea" class="bulk-preview-area">
                <!-- Será preenchido dinamicamente -->
            </div>
        </div>
    </div>
</div>

<!-- MODAL SECUNDÁRIO: VER EMPRESAS -->
<div id="bulkCompaniesModal" class="modal">
    <div class="modal-content bulk-companies-modal-content">
        <div class="modal-header">
            <h2>Empresas e Valores</h2>
            <button class="modal-close" onclick="closeBulkCompaniesModal()">&times;</button>
        </div>
        <div class="modal-form">
            <div id="bulkCompaniesContent">
                <!-- Será preenchido dinamicamente -->
            </div>
