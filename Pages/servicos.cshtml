<!-- MODAL VISUALIZAR SERVIÇO -->
<div id="viewModal" class="modal">
    <div class="modal-content modal-view">
        <div class="modal-header">
            <h2>Detalhes da Cotação</h2>
            <button class="modal-close" onclick="closeViewModal()">&times;</button>
        </div>
        <div class="modal-view-content">
            <!-- SEÇÃO 1: Responsável e Setor -->
            <div class="view-section section-header">
                <div class="view-row-header">
                    <div class="view-item-header">
                        <span class="view-label">👤 Responsável</span>
                        <span class="view-value-header">Rafael Pequino Freire</span>
                    </div>
                    <div class="view-item-header">
                        <span class="view-label">🏢 Setor</span>
                        <span class="view-value-header">Elétrica</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 2: Informações Principais -->
            <div class="view-section">
                <h3>📋 Informações da Cotação</h3>
                <div class="info-grid">
                    <div class="info-card">
                        <span class="info-label">I0 Original</span>
                        <span class="info-value">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Item</span>
                        <span class="info-value">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Unidade</span>
                        <span class="info-value">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Adotada</span>
                        <span class="info-value price">-</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label">Preço Montagem</span>
                        <span class="info-value price">-</span>
                    </div>
                    <div class="info-card highlight">
                        <span class="info-label">Preço Adotado</span>
                        <span class="info-value price-main">-</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 3: Médias e Medianas -->
            <div class="view-section">
                <h3>📊 Médias e Estatísticas</h3>
                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-label">Média Adotada</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Média Saneada</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Menor Valor</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Média Aritmética</span>
                        <span class="stat-value">-</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Mediana</span>
                        <span class="stat-value">-</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 4: Preços das Empresas -->
            <div class="view-section">
                <h3>🏪 Cotações das Empresas</h3>
                <div class="companies-grid">
                    <div class="company-card" id="company-card-1">
                        <span class="company-label" id="company-name-1">Empresa 1</span>
                        <span class="company-value" id="company-value-1">-</span>
                    </div>
                    <div class="company-card" id="company-card-2">
                        <span class="company-label" id="company-name-2">Empresa 2</span>
                        <span class="company-value" id="company-value-2">-</span>
                    </div>
                    <div class="company-card" id="company-card-3">
                        <span class="company-label" id="company-name-3">Empresa 3</span>
                        <span class="company-value" id="company-value-3">-</span>
                    </div>
                    <div class="company-card" id="company-card-4">
                        <span class="company-label" id="company-name-4">Empresa 4</span>
                        <span class="company-value" id="company-value-4">-</span>
                    </div>
                    <div class="company-card" id="company-card-5">
                        <span class="company-label" id="company-name-5">Empresa 5</span>
                        <span class="company-value" id="company-value-5">-</span>
                    </div>
                    <div class="company-card" id="company-card-6">
                        <span class="company-label" id="company-name-6">Empresa 6</span>
                        <span class="company-value" id="company-value-6">-</span>
                    </div>
                </div>
            </div>

            <!-- SEÇÃO 5: Justificativa -->
            <div class="view-section">
                <h3>📝 Justificativa</h3>
                <div class="justification-box">
                    <p class="justification-text">-</p>
                </div>
            </div>

            <!-- SEÇÃO 6: Anexos -->
            <div class="view-section">
                <h3>📎 Anexos (PDFs)</h3>
                <div id="viewAttachmentsList">
                    <p class="view-text" style="color: #999;">Nenhum anexo disponível</p>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeViewModal()">Fechar</button>
                <button type="button" class="btn-submit" onclick="editFromView()">Editar</button>
            </div>
        </div>
    </div>
</div>

<script>
    // MODAL CRIAR
    const btnNovaCotacao = document.querySelector('.btn-nova-cotacao');
    const createModal = document.getElementById('createModal');
    
    btnNovaCotacao.addEventListener('click', function() {
        createModal.style.display = 'flex';
    });

    function closeCreateModal() {
        createModal.style.display = 'none';
    }

    // MODAL EDITAR
    const editModal = document.getElementById('editModal');

    function openEditModal() {
        editModal.style.display = 'flex';
    }

    function closeEditModal() {
        editModal.style.display = 'none';
    }

    // MODAL VISUALIZAR
    const viewModal = document.getElementById('viewModal');

    function openViewModal() {
        viewModal.style.display = 'flex';
    }

    function closeViewModal() {
        viewModal.style.display = 'none';
    }

    function editFromView() {
        closeViewModal();
        openEditModal();
    }

    // Função para copiar dados
    // Função para mostrar notificação de cópia
    function showCopyNotification() {
        const notification = document.createElement('div');
        notification.className = 'copy-notification';
        notification.textContent = '✓ Dados copiados para a área de transferência';
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('show');
        }, 10);

        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
                document.body.removeChild(notification);
            }, 300);
        }, 2000);
    }

    // Função para colar dados da planilha
    function pasteFromClipboard() {
        navigator.clipboard.readText().then((text) => {
            try {
                // Usar o parser para processar os dados
                const parsedData = parseClipboardData(text);
                
                // Preencher o formulário com os dados parseados
                fillFormWithParsedData(createModal, parsedData);
                
                showPasteNotification();
            } catch (error) {
                alert('Erro ao processar dados da planilha: ' + error.message);
                console.error('Erro completo:', error);
            }
        }).catch(() => {
            alert('Não foi possível acessar a área de transferência. Verifique as permissões do navegador.');
        });
    }

    // Função para mostrar notificação de cola
    function showPasteNotification() {
        const notification = document.createElement('div');
        notification.className = 'paste-notification';
        notification.textContent = '✓ Dados colados com sucesso';
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('show');
        }, 10);

        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
                document.body.removeChild(notification);
            }, 300);
        }, 2000);
    }

    // Adicionar funcionalidade de cópia aos botões
    document.querySelectorAll('.btn-copiar').forEach((btn, index) => {
        btn.addEventListener('click', function() {
            copyServiceData('fev/2026');
        });
    });

    // Fechar modal ao clicar fora
    window.addEventListener('click', function(event) {
        if (event.target === createModal) {
            closeCreateModal();
        }
        if (event.target === editModal) {
            closeEditModal();
        }
        if (event.target === viewModal) {
            closeViewModal();
        }
    });

    // Fechar modais com a tecla ESC
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            if (createModal.style.display === 'flex') {
                closeCreateModal();
            }
            if (editModal.style.display === 'flex') {
                closeEditModal();
            }
            if (viewModal.style.display === 'flex') {
                closeViewModal();
            }
        }
    });
</script>

