@page
@model CotacoesEPC.Pages.fornecedoresModel
@{
    Layout = null;
    ViewData["Title"] = "Fornecedores";
}

<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - CotacoesEPC</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>

<header class="dashboard-header">
    <div class="logo-area">
        <img src="~/images/sabesp.svg" alt="sabesp" class="logo" />
    </div>

    <button class="menu-toggle" aria-label="Menu">☰</button>

    <nav class="menu">
        <a class="menu-item" href="/dashboard">Dashboard</a>
        <a class="menu-item" href="/cotacoes">Cotações</a>
        <a class="menu-item active" href="/fornecedores">Fornecedores</a>
        <a class="menu-item" href="/planilhas">Planilhas</a>
    </nav>

    <div class="user-area">
        <button class="user" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-icon">@(Model.UserName?.FirstOrDefault().ToString().ToUpper() ?? "R")</div>
            <span class="user-name">@Model.UserName</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuBtn">
            <li><h6 class="dropdown-header d-md-none">@Model.UserName</h6></li>
            <li><hr class="dropdown-divider d-md-none"></li>
            <li><a class="dropdown-item" href="#" onclick="logout(event)">Sair</a></li>
        </ul>
    </div>
</header>

<main class="dashboard-container">
    <div class="servicos-header">
        <h2 class="title">Fornecedores</h2>
        <div class="header-buttons">
            <button class="btn-nova-cotacao btn-criar-individual" onclick="openCreateModal()">+ Novo Fornecedor</button>
        </div>
    </div>

    <section class="servicos-filters">
        <div class="search-group">
            <input type="text" class="search-input" id="searchInput" placeholder="Pesquisar por nome, CNPJ ou telefone" />
            <button class="btn-filtrar" id="btnFiltrar">🔍 Buscar</button>
            <button class="btn-limpar" id="btnLimpar">Limpar Busca</button>
        </div>
    </section>

    <div id="searchIndicator" style="display: none; padding: 12px 16px; background: #e8f4f8; border-left: 4px solid #19d6ff; margin-bottom: 16px; border-radius: 4px;">
        <span style="color: #333; font-weight: 500;">Buscando por: <strong id="searchText"></strong></span>
    </div>

    <section class="servicos-table">
        <div id="emptyMessage" style="display: none; text-align: center; color: #999; padding: 60px 20px; font-size: 18px;">
            Nenhum fornecedor cadastrado. Crie um novo!
        </div>
        <table id="fornecedoresTableElement">
            <thead>
                <tr>
                    <th>Nome Fantasia</th>
                    <th>CNPJ</th>
                    <th>Telefone</th>
                    <th>Endereço</th>
                    <th>Data de Cadastro</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </section>
</main>

<!-- MODAL CRIAR NOVO FORNECEDOR -->
<div id="createModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h2>Novo Fornecedor</h2>
            <button class="modal-close" onclick="closeCreateModal()">&times;</button>
        </div>
        <form class="modal-form" id="createForm">
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Nome Fantasia*</label>
                    <input type="text" name="nomeFantasia" placeholder="Ex: SABESP" maxlength="200" required />
                </div>
            </div>

            <div class="form-row form-row-2col">
                <div class="form-group">
                    <label>CNPJ*</label>
                    <input type="text" name="cnpj" placeholder="Ex: 12.345.678/0001-90" maxlength="18" oninput="maskCNPJ(this)" required />
                </div>
                <div class="form-group">
                    <label>Telefone*</label>
                    <input type="text" name="telefone" placeholder="Ex: (11) 98765-4321" maxlength="15" oninput="maskTelefone(this)" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label>Endereço*</label>
                    <input type="text" name="endereco" placeholder="Ex: Rua das Flores, 123, São Paulo - SP" maxlength="500" required />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeCreateModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Salvar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL EDITAR FORNECEDOR -->
<div id="editModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h2>Editar Fornecedor</h2>
            <button class="modal-close" onclick="closeEditModal()">&times;</button>
        </div>
        <form class="modal-form" id="editForm">
            <div class="form-row">
                <div class="form-group full-width">
                    <label>Nome Fantasia*</label>
                    <input type="text" name="nomeFantasia" placeholder="Ex: SABESP" maxlength="200" required />
                </div>
            </div>

            <div class="form-row form-row-2col">
                <div class="form-group">
                    <label>CNPJ*</label>
                    <input type="text" name="cnpj" placeholder="Ex: 12.345.678/0001-90" maxlength="18" oninput="maskCNPJ(this)" required />
                </div>
                <div class="form-group">
                    <label>Telefone*</label>
                    <input type="text" name="telefone" placeholder="Ex: (11) 98765-4321" maxlength="15" oninput="maskTelefone(this)" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group full-width">
                    <label>Endereço*</label>
                    <input type="text" name="endereco" placeholder="Ex: Rua das Flores, 123, São Paulo - SP" maxlength="500" required />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Atualizar</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
<script src="~/js/api.js"></script>
<script src="~/js/crud.js"></script>
<script src="~/js/fornecedores-page.js" asp-append-version="true"></script>

</body>
</html>
