@page
@model CotacoesEPC.Pages.dashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Dashboard";
}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - CotacoesEPC</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />
<script src="~/js/api.js"></script>

<header class="dashboard-header">
    <div class="logo-area">
        <img src="~/images/sabesp.svg" alt="sabesp" class="logo" />
    </div>

    <button class="menu-toggle" aria-label="Menu" aria-expanded="false"><span class="hamburger-icon"></span></button>

    <nav class="menu">
        <a class="menu-item active" href="/dashboard">Início</a>
        <a class="menu-item" href="/cotacoes">Cotações</a>
        <a class="menu-item" href="/fornecedores">Fornecedores</a>
        <a class="menu-item" href="/planilhas">Planilhas</a>
        <a class="menu-item menu-logout" href="#" onclick="logout(event)">Sair</a>
    </nav>

    <div class="user-area">
        <div class="user" id="userMenuBtn">
            <div class="user-icon">@(Model.UserName?.FirstOrDefault().ToString().ToUpper() ?? "?")</div>
            <span class="user-name">@Model.UserName</span>
        </div>
    </div>
</header>

<main class="dashboard-container">
    <div class="page-heading">
        <h2 class="title">Visão geral</h2>
        <p class="page-description">Acompanhe os principais indicadores do sistema de cotações.</p>
    </div>

    <section class="cards">
        <a class="card" href="/cotacoes">
            <div class="icon">
                <span class="ui-icon ui-icon-tag" aria-hidden="true"></span>
            </div>
            <div class="numbers">
                <h3><span id="quotationsCount">0</span></h3>
                <p>Cotações</p>
            </div>
        </a>

        <a class="card" href="/fornecedores">
            <div class="icon">
                <span class="ui-icon ui-icon-users" aria-hidden="true"></span>
            </div>
            <div class="numbers">
                <h3><span id="suppliersCount">0</span></h3>
                <p>Fornecedores</p>
            </div>
        </a>

        <a class="card" href="/planilhas">
            <div class="icon">
                <span class="ui-icon ui-icon-file" aria-hidden="true"></span>
            </div>
            <div class="numbers">
                <h3><span id="spreadsheetsCount">0</span></h3>
                <p>Planilhas</p>
            </div>
        </a>
    </section>

</main>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
<script src="~/js/api.js"></script>
<script src="~/js/crud.js"></script>
<script src="~/js/dashboard.js"></script>