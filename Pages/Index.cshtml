@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Cotações";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CotacoesEPC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/login.css" />
    <style>
        body {
            background: #13d0ff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 16px;
        }

        .login-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            padding: 40px;
            max-width: 400px;
            width: 100%;
        }

        .logo {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 40px auto;
            width: 100%;
        }

        .logo img {
            max-width: 150px;
            height: auto;
            display: block;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            display: block;
            font-size: 14px;
        }

        .form-control {
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            width: 100%;
            box-sizing: border-box;
        }

        .form-control:focus {
            border-color: #13d0ff;
            box-shadow: 0 0 0 0.2rem rgba(19, 208, 255, 0.25);
            outline: none;
        }

        .btn-login {
            background: #13d0ff;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: transform 0.2s, background-color 0.2s;
        }

        .btn-login:hover {
            background: #00bfff;
            transform: translateY(-2px);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .divider {
            text-align: center;
            margin: 20px 0;
            color: #999;
            font-size: 14px;
        }

        .signup-link {
            text-align: center;
            margin-top: 20px;
        }

        .signup-link a {
            color: #13d0ff;
            text-decoration: none;
            font-weight: 600;
        }

        .signup-link a:hover {
            text-decoration: underline;
        }

        .alert {
            margin-bottom: 20px;
            border-radius: 6px;
        }

        .subtitle {
            text-align: center;
            color: #666;
            font-size: 16px;
            margin-bottom: 30px;
            font-weight: 500;
        }

        /* Responsividade Mobile */
        @@media (max-width: 480px) {
            body {
                padding: 12px;
            }

            .login-container {
                padding: 28px 24px;
                border-radius: 12px;
            }

            .logo img {
                max-width: 120px;
            }

            .subtitle {
                font-size: 14px;
                margin-bottom: 24px;
            }

            .form-label {
                font-size: 13px;
            }

            .form-control {
                padding: 11px 14px;
                font-size: 16px; /* Previne zoom em iOS */
            }

            .btn-login {
                padding: 13px;
                font-size: 15px;
            }

            .divider {
                margin: 16px 0;
                font-size: 13px;
            }

            .signup-link {
                margin-top: 16px;
                font-size: 14px;
            }

            .form-group {
                margin-bottom: 16px;
            }
        }

        /* Tablets e telas menores */
        @@media (max-width: 768px) and (min-width: 481px) {
            .login-container {
                padding: 36px 32px;
            }
        }

        /* Landscape mobile */
        @@media (max-height: 600px) and (orientation: landscape) {
            body {
                padding: 8px;
                align-items: flex-start;
                padding-top: 20px;
            }

            .login-container {
                margin: 20px auto;
                padding: 24px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .logo img {
                max-width: 100px;
            }

            .subtitle {
                font-size: 14px;
                margin-bottom: 20px;
            }

            .form-group {
                margin-bottom: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <img src="~/images/sabesp.svg" alt="SABESP" />
        </div>

        <p class="subtitle">Sistema de Compartilhamento de Cotações</p>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <form id="loginForm" onsubmit="handleLogin(event)">
            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required placeholder="seu@email.com" />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Senha</label>
                <input type="password" class="form-control" id="password" name="password" required placeholder="Sua senha" />
            </div>

            <button type="submit" class="btn-login">Entrar</button>
        </form>

        <div class="divider">ou</div>

        <div class="signup-link">
            Não tem conta? <a href="/cadastro">Cadastre-se aqui</a>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api.js"></script>
    <script>
        async function handleLogin(event) {
            event.preventDefault();

            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;

            // Validação de campos vazios
            if (!email || !password) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Campos Obrigatórios',
                    text: 'Por favor, preencha email e senha',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#13d0ff'
                });
                return;
            }

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email, password })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // Redirecionar direto para dashboard
                    window.location.href = '/dashboard';
                } else {
                    const errorMessage = result?.message || 'Erro desconhecido';
                    
                    // Determinar tipo de erro baseado na mensagem
                    let errorTitle = 'Login Inválido';
                    let errorIcon = 'warning';
                    let confirmButtonColor = '#13d0ff';
                    
                    if (errorMessage.includes('Não encontrado') || errorMessage.includes('Credenciais inválidas')) {
                        errorTitle = 'Credenciais inválidas';
                        errorIcon = 'warning';
                    } else if (errorMessage.includes('desativada')) {
                        errorTitle = 'Conta Desativada';
                        errorIcon = 'error';
                        confirmButtonColor = '#ff6b6b';
                    } else if (errorMessage.includes('Erro interno') || errorMessage.includes('servidor')) {
                        errorTitle = 'Erro do Servidor';
                        errorIcon = 'error';
                        confirmButtonColor = '#ff6b6b';
                    }
                    
                    await Swal.fire({
                        icon: errorIcon,
                        title: errorTitle,
                        text: errorMessage,
                        confirmButtonText: 'Tentar Novamente',
                        confirmButtonColor: confirmButtonColor
                    });
                }
            } catch (error) {
                console.error('Erro na requisição:', error);
                
                let errorTitle = 'Erro de Conexão';
                let errorMessage = 'Ocorreu um erro ao conectar ao servidor. Verifique sua conexão e tente novamente.';
                let errorIcon = 'error';
                
                // Verificar se é erro de rede
                if (!navigator.onLine) {
                    errorTitle = 'Sem Conexão';
                    errorMessage = 'Você está offline. Verifique sua conexão com a internet.';
                    errorIcon = 'warning';
                } else if (error.name === 'TypeError' && error.message.includes('fetch')) {
                    errorTitle = 'Servidor Indisponível';
                    errorMessage = 'Não foi possível conectar ao servidor. O serviço pode estar temporariamente indisponível.';
                }
                
                await Swal.fire({
                    icon: errorIcon,
                    title: errorTitle,
                    text: errorMessage,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#13d0ff'
                });
            }
        }
    </script>
</body>
</html>
